# Streamlit Community Cloud -> App settings -> Secrets. Plain strings only.
DATABASE_URL = "postgresql://user:pass@host/db"   # Neon/Supabase; SQLite is wiped on restart
ADMIN_EMAIL = "admin@yourdomain.com"
ADMIN_PASSWORD = "change-me-strong"
JWT_SECRET = "long-random-string"
PAYMENT_PROVIDER = "mock"

# AI SDR (all optional; defaults are safe: mock discovery, dry-run email)
SDR_DISCOVERY_PROVIDER = "mock"                    # or apollo_api
# SDR_DISCOVERY_APOLLO_API_KEY = ""
# SDR_DISCOVERY_APOLLO_ALLOW_PUBLIC_FALLBACK = "false"
SDR_OUTREACH_PROVIDER = "dry_run"                  # or brevo
# SDR_OUTREACH_BREVO_API_KEY = ""
# SDR_OUTREACH_FROM_EMAIL = "verified-sender@your-domain.com"
# Shopify marketplace
# SHOPIFY_API_SECRET = ""
